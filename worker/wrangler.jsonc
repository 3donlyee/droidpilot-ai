// aMiNo — Cloudflare Worker configuration.
//
// IMPORTANT (security): no secrets live in this file or anywhere in the repo.
//   - DEVICE_AUTH_SECRET   → `wrangler secret put DEVICE_AUTH_SECRET` (ALREADY
//     set on the live worker — never re-put it, existing pairing would survive
//     but keep it stable anyway).
//
// CRITICAL (continuity): this worker IS the user's live deployment
// (https://droidpilot-ai.droidpilot.workers.dev). The KV namespace ids below
// are the LIVE ones (fetched from the running worker's bindings) — his real
// phone is registered in KV_DEVICES. Do NOT swap these for fresh namespaces:
// that would silently unpair every device.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "droidpilot-ai",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",

  // Static Web UI served from ../web (same origin as the API → no CORS needed)
  "assets": {
    "directory": "../web",
    "binding": "ASSETS"
  },

  // Workers AI binding — accessed as env.AI
  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    { "binding": "KV_DEVICES", "id": "207ce78675a24f3cbdaafd8ffd488469" },
    { "binding": "KV_TURNS",   "id": "8e1cafba93e0462dbcdc53102fe645cb" },
    { "binding": "KV_RATE",    "id": "c0aea6e5f61a44398463c4b443151f77" },
    { "binding": "KV_LOGS",    "id": "21b56f97b0e8473e8b04b611302281fa" }
  ],

  "vars": {
    "MAX_TOOL_CALLS_PER_TURN": "20",
    "AI_PROVIDER": "workers-ai",
    "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
    "DEBUG": "false"
  }
}
