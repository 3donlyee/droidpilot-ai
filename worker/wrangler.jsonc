// DroidPilot AI — Cloudflare Worker configuration.
//
// IMPORTANT (security): no secrets live in this file or anywhere in the repo.
//   - DEVICE_AUTH_SECRET   → `wrangler secret put DEVICE_AUTH_SECRET`
//   - OPENAI_API_KEY       → only if you enable the "openai-compat" provider
// The KV namespace ids below are account-specific but are NOT secrets
// (standard wrangler practice). For a fresh Cloudflare account, either delete
// them and run scripts/deploy-cloudflare.sh (auto-creates + injects), or run:
//   wrangler kv namespace create KV_DEVICES   (…and the other three)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "droidpilot-ai",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",

  // Static Web UI served from ../web (same origin as the API → no CORS needed)
  "assets": {
    "directory": "../web",
    "binding": "ASSETS"
  },

  // Workers AI binding — accessed as env.AI
  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    { "binding": "KV_DEVICES", "id": "aeccd1e48588423e96bed09ba89b2cb8" },
    { "binding": "KV_TURNS",   "id": "7b958ae3aab34ae6aba4a783a1f2624b" },
    { "binding": "KV_RATE",    "id": "2ab59f32624a4c0a9bae501b36aad5c6" },
    { "binding": "KV_LOGS",    "id": "ebe9df399ca04d37a7e707208af08c29" }
  ],

  "vars": {
    "MAX_TOOL_CALLS_PER_TURN": "20",
    "AI_PROVIDER": "workers-ai",
    "DEBUG": "false"
  }
}
